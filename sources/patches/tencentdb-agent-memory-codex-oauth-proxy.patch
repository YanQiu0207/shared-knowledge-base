+/** Transparently proxy Codex's startup model-catalog refresh. */
+export async function handleCodexModels(
+  c: Context,
+  config: ProxyConfig,
+): Promise<Response> {
+  const memoryUserKey = extractCodexMemoryUserKey(c.req.raw.headers);
+  const spaceId = extractSpaceIdFromPath(c.req.path) ?? "";
+  const { rejected, rejectReason } = await verifyUserKey(memoryUserKey, spaceId);
+  if (rejected) {
+    return c.json(
+      { error: `Authentication failed: ${rejectReason ?? "unknown"}` },
+      401,
+    );
+  }
+
+  const agentUpstreamEntry = config.upstream.agents?.["codex"];
+  const upstreamBase = agentUpstreamEntry?.url || config.upstream.url;
+  const upstreamUrl = buildCodexModelsUpstreamUrl(upstreamBase, c.req.url);
+  const upstreamHeaders = buildUpstreamHeaders(c, config, agentUpstreamEntry);
+
+  try {
+    const upstreamResp = await fetch(upstreamUrl, {
+      method: "GET",
+      headers: upstreamHeaders,
+    });
+    return new Response(upstreamResp.body, {
+      status: upstreamResp.status,
+      headers: filterResponseHeaders(upstreamResp.headers),
+    });
+  } catch (err: unknown) {
+    log.error("codex.models.forward_failed", {
+      upstreamUrl,
+      error: err instanceof Error ? err.message : String(err),
+    });
+    return c.json({ error: "Upstream request failed" }, 502);
+  }
+}
