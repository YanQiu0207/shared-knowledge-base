+import { describe, expect, it } from "vitest";
+
+import {
+  buildCodexModelsUpstreamUrl,
+  buildCodexUpstreamHeaders,
+  extractCodexMemoryUserKey,
+  resolveCodexUpstreamAuthorization,
+} from "../codex-auth.js";
+
+describe("extractCodexMemoryUserKey", () => {
+  it("prefers the dedicated Memory key over the upstream OAuth token", () => {
+    const headers = new Headers({
+      authorization: "Bearer oauth-token",
+      "x-tdai-user-key": "memory-user-key",
+      "x-api-key": "fallback-key",
+    });
+
+    expect(extractCodexMemoryUserKey(headers)).toBe("memory-user-key");
+  });
+
+  it("keeps Bearer authentication backward compatible", () => {
+    const headers = new Headers({ authorization: "Bearer memory-user-key" });
+
+    expect(extractCodexMemoryUserKey(headers)).toBe("memory-user-key");
+  });
+
+  it("falls back to x-api-key", () => {
+    const headers = new Headers({ "x-api-key": "memory-user-key" });
+
+    expect(extractCodexMemoryUserKey(headers)).toBe("memory-user-key");
+  });
+});
+
+describe("resolveCodexUpstreamAuthorization", () => {
+  it("preserves OAuth when a per-agent URL intentionally omits apiKey", () => {
+    expect(
+      resolveCodexUpstreamAuthorization("Bearer oauth-token", "global-key", undefined, true),
+    ).toBe("Bearer oauth-token");
+  });
+
+  it("uses a per-agent apiKey when provided", () => {
+    expect(
+      resolveCodexUpstreamAuthorization("Bearer oauth-token", "global-key", "agent-key", true),
+    ).toBe("Bearer agent-key");
+  });
+
+  it("uses the global apiKey without a per-agent override", () => {
+    expect(
+      resolveCodexUpstreamAuthorization("Bearer oauth-token", "global-key", undefined, false),
+    ).toBe("Bearer global-key");
+  });
+});
+
+describe("buildCodexModelsUpstreamUrl", () => {
+  it("targets the Codex catalog endpoint and preserves the client query", () => {
+    expect(
+      buildCodexModelsUpstreamUrl(
+        "https://chatgpt.com/backend-api/codex/",
+        "http://proxy/codex/default/v1/models?client_version=0.154.0",
+      ),
+    ).toBe("https://chatgpt.com/backend-api/codex/models?client_version=0.154.0");
+  });
+});
+
+describe("buildCodexUpstreamHeaders", () => {
+  it("keeps OAuth and strips the dedicated Memory credential", () => {
+    const headers = buildCodexUpstreamHeaders(
+      new Headers({
+        authorization: "Bearer oauth-token",
+        "x-tdai-user-key": "memory-user-key",
+        "user-agent": "codex-cli",
+      }),
+      "global-key",
+      undefined,
+      true,
+    );
+
+    expect(headers.authorization).toBe("Bearer oauth-token");
+    expect(headers["x-tdai-user-key"]).toBeUndefined();
+    expect(headers["user-agent"]).toBe("codex-cli");
+  });
+});
