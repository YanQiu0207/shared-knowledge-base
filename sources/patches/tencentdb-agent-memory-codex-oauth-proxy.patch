new file mode 100644
index 0000000..fef0016
--- /dev/null
+++ b/MemoryProxy/src/codex-auth.ts
@@ -0,0 +1,63 @@
+import { extractBearerToken } from "./opik.js";
+
+const SKIP_UPSTREAM_REQUEST_HEADERS = new Set([
+  "host",
+  "content-length",
+  "transfer-encoding",
+  "connection",
+  "x-tdai-user-key",
+]);
+
+/** Resolve Memory authentication without consuming the upstream OAuth token. */
+export function extractCodexMemoryUserKey(headers: Headers): string {
+  return headers.get("x-tdai-user-key")?.trim() ||
+    extractBearerToken(headers.get("authorization") ?? "") ||
+    headers.get("x-api-key") ||
+    "";
+}
+
+export function resolveCodexUpstreamAuthorization(
+  requestAuthorization: string | null,
+  globalApiKey: string,
+  agentApiKey: string | undefined,
+  hasAgentOverride: boolean,
+): string | null {
+  if (hasAgentOverride) {
+    return agentApiKey ? `Bearer ${agentApiKey}` : requestAuthorization;
+  }
+  return globalApiKey ? `Bearer ${globalApiKey}` : requestAuthorization;
+}
+
+export function buildCodexModelsUpstreamUrl(
+  upstreamBase: string,
+  requestUrl: string,
+): string {
+  const search = new URL(requestUrl).search;
+  return `${upstreamBase.replace(/\/+$/, "")}/models${search}`;
+}
+
+export function buildCodexUpstreamHeaders(
+  requestHeaders: Headers,
+  globalApiKey: string,
+  agentApiKey: string | undefined,
+  hasAgentOverride: boolean,
+): Record<string, string> {
+  const headers: Record<string, string> = {};
+  for (const [key, value] of requestHeaders.entries()) {
+    if (!SKIP_UPSTREAM_REQUEST_HEADERS.has(key.toLowerCase())) {
+      headers[key] = value;
+    }
+  }
+
+  const authorization = resolveCodexUpstreamAuthorization(
+    requestHeaders.get("authorization"),
+    globalApiKey,
+    agentApiKey,
+    hasAgentOverride,
+  );
+  if (authorization) {
+    headers.authorization = authorization;
+    delete headers["x-api-key"];
+  }
+  return headers;
+}
